# =====================================================================
# PlanBA Métré Extracteur — fichiers exclus du versionnement
# =====================================================================

# --- Distribution & build (lourds, régénérables : build_executable.py) ---
dist/
build/
templates/
*.spec
# Packages de diffusion (trop lourds pour GitHub, distribués à part)
PlanBA_Metre_Extractor*.zip
deployment/
functional-output/

# --- Données lourdes locales (jamais versionnées) ---
dataset/raw/
dataset/kaggle/
dataset/external/
*.onnx
*.bin

# --- Références PDF lourdes ---
# Seuls reference/PLAN_BA_final.pdf et reference/metre_MZINDA.xlsx sont suivis
reference/
!reference/PLAN_BA_final.pdf
!reference/metre_MZINDA.xlsx

# --- Sorties générées : sous-dossiers ignorés ---
# (les fichiers racine historiques output/*.xlsx|json|pdf restent suivis)
output/*/

# --- Environnements & caches Python ---
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.deps_installed

# --- Raccourcis / sauvegardes Windows ---
*.lnk
*.vbs
*.bak
*~

# --- Clones de référence (licences hétérogènes) ---
research/

# --- Dépendances front ---
electron/node_modules/

# --- Logs & système ---
*.log
.DS_Store
Thumbs.db
